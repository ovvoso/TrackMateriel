{% extends 'base.html.twig' %}

{% block title %}Attribution{% endblock %}

{% block body %}
    <h1>Attribution</h1>

    <table class="table">
        <tbody>
            {# <tr>
                <th>Id</th>
                <td>{{ attribution.id }}</td>
            </tr> #}
            <tr>
                <th>Date d'attribution</th>
                <td>{{ attribution.dateAttribution ? attribution.dateAttribution|date('d/m/Y H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Équipement</th>
                <td>{{ attribution.equipement ? attribution.equipement.nom : '' }}</td>
            </tr>
            <tr>
                <th>Type d'équipement</th>
                <td>{{ attribution.equipement ? attribution.equipement.type : '' }}</td>
            </tr>
            <tr>
                <th>État de l'équipement</th>
                <td>{{ attribution.equipement ? attribution.equipement.etat : '' }}</td>
            </tr>
            <tr>
                <th>Utilisateur</th>
                <td>{{ attribution.utilisateur ? attribution.utilisateur.username : '' }}</td>
            </tr>
            <tr>
                <th>Email utilisateur</th>
                <td>{{ attribution.utilisateur ? attribution.utilisateur.email : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_attribution_index') }}">back to list</a>

    <a href="{{ path('app_attribution_edit', {'id': attribution.id}) }}">edit</a>

    {{ include('attribution/_delete_form.html.twig') }}
{% endblock %}
