<form method="post" action="{{ path('app_attribution_delete', {'id': attribution.id}) }}" style="display: inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ attribution.id) }}">
    <button type="submit" class="btn btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette attribution ?');">
        <i class="fas fa-trash me-2"></i>Confirmer la suppression
    </button>
</form>
