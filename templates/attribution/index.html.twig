{% extends 'base.html.twig' %}

{% block title %}Attribution index{% endblock %}

{% block body %}
    <h1>Attribution index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Date d'attribution</th>
                <th>Equipement</th>
                <th>Utilisateur</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for attribution in attributions %}
            <tr>
                <td>{{ attribution.id }}</td>
                <td>{{ attribution.dateAttribution ? attribution.dateAttribution|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ attribution.equipement ? attribution.equipement.nom : '' }}</td>
                <td>{{ attribution.utilisateur ? attribution.utilisateur.username : '' }}</td>
                <td>
                    <a href="{{ path('app_attribution_show', {'id': attribution.id}) }}">show</a>
                    <a href="{{ path('app_attribution_edit', {'id': attribution.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_attribution_new') }}">Create new</a>
{% endblock %}
