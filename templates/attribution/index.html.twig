{% extends 'base.html.twig' %}

{% block title %}Gestion des Attributions{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <!-- improved design -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">
            <i class="fas fa-user-cog icon-contextual"></i>
            {% if is_granted('ROLE_ADMIN') %}
                Gestion des Attributions
            {% else %}
                Mes Attributions
            {% endif %}
        </h1>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_attribution_new') }}" class="btn btn-success btn-lg btn-add">
                <i class="fas fa-plus me-2"></i>Nouvelle Attribution
            </a>
        {% endif %}
    </div>

    {% if attributions|length > 0 %}
        <!-- improved design -->
        <div class="card card-modern">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 table-modern">
                        <thead>
                            <tr>
                                <th><i class="fas fa-hashtag icon-contextual"></i>ID</th>
                                <th><i class="fas fa-calendar icon-contextual"></i>Date d'attribution</th>
                                <th><i class="fas fa-desktop icon-contextual"></i>Équipement</th>
                                <th><i class="fas fa-user icon-contextual"></i>Utilisateur</th>
                                <th class="text-center"><i class="fas fa-cogs icon-contextual"></i>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for attribution in attributions %}
                            <tr>
                                <td class="fw-bold">{{ attribution.id }}</td>
                                <td>
                                    {# <i class="fas fa-clock icon-contextual text-muted"></i> #}
                                    {{ attribution.dateAttribution ? attribution.dateAttribution|date('d/m/Y H:i') : '' }}
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        {# <i class="fas fa-desktop icon-contextual text-primary"></i> #}
                                        <div>
                                            <div class="fw-semibold">{{ attribution.equipement ? attribution.equipement.nom : 'N/A' }}</div>
                                            <small class="text-muted">{{ attribution.equipement ? attribution.equipement.type : '' }}</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        {# <i class="fas fa-user icon-contextual text-success"></i> #}
                                        <span>{{ attribution.utilisateur ? attribution.utilisateur.username : 'N/A' }}</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <!-- improved design - boutons d'action avec icônes circulaires -->
                                    <div class="d-flex justify-content-center gap-2">
                                        {# Tous les utilisateurs peuvent voir les détails de leurs attributions #}
                                        {% if is_granted('ROLE_ADMIN') or attribution.utilisateur == app.user %}
                                            <a href="{{ path('app_attribution_show', {'id': attribution.id}) }}" 
                                               class="btn-action btn-view" title="Voir les détails">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        {% endif %}
                                        
                                        {# Seuls les admins peuvent modifier/supprimer #}
                                        {% if is_granted('ROLE_ADMIN') %}
                                            <a href="{{ path('app_attribution_edit', {'id': attribution.id}) }}" 
                                               class="btn-action btn-edit" title="Modifier">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button" class="btn-action btn-delete" 
                                                    title="Supprimer" onclick="deleteAttribution({{ attribution.id }})">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% else %}
        <!-- improved design -->
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="fas fa-user-slash fa-4x text-muted"></i>
            </div>
            <h4 class="text-muted mb-3">
                {% if is_granted('ROLE_ADMIN') %}
                    Aucune attribution trouvée
                {% else %}
                    Aucune attribution trouvée pour votre compte
                {% endif %}
            </h4>
            <p class="text-muted mb-4">
                {% if is_granted('ROLE_ADMIN') %}
                    Commencez par créer votre première attribution
                {% else %}
                    Aucun équipement ne vous est actuellement attribué
                {% endif %}
            </p>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_attribution_new') }}" class="btn btn-primary btn-add">
                    <i class="fas fa-plus me-2"></i>Créer une attribution
                </a>
            {% endif %}
        </div>
    {% endif %}
</div>

{# Modal de confirmation de suppression - seulement pour les admins #}
{% if is_granted('ROLE_ADMIN') %}
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle text-warning me-2"></i>Confirmer la suppression
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Êtes-vous sûr de vouloir supprimer cette attribution ?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    <input type="hidden" name="_token" id="deleteToken">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-2"></i>Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
function deleteAttribution(id) {
    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
    const form = document.getElementById('deleteForm');
    form.action = '/attribution/' + id;
    
    // Generate proper CSRF token
    fetch('/attribution/' + id + '/token', {
        method: 'GET',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        document.getElementById('deleteToken').value = data.token;
        modal.show();
    })
    .catch(error => {
        // Fallback: use a static token approach
        document.getElementById('deleteToken').value = 'delete' + id;
        modal.show();
    });
}
</script>
{% endif %}
{% endblock %}
