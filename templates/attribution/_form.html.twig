{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}
<!-- improved design -->
<div class="card card-modern">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">
            <i class="fas fa-user-cog icon-contextual"></i>Informations de l'attribution
        </h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-12 mb-4">
                <div class="form-group">
                    <i class="fas fa-calendar-alt icon-contextual"></i>
                    {{ form_label(form.dateAttribution, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.dateAttribution, {'attr': {'class': 'form-control'}}) }}
                    {# <div class="form-text">
                        <i class="fas fa-calendar-alt icon-contextual"></i>
                        Date et heure d'attribution de l'équipement
                    </div> #}
                    {{ form_errors(form.dateAttribution) }}
                </div>
            </div>
            
            <div class="col-md-6 mb-3">
                <div class="form-group">
                    <i class="fas fa-desktop icon-contextual"></i>
                    {{ form_label(form.equipement, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.equipement, {'attr': {'class': 'form-select'}}) }}
                    {# <div class="form-text">
                        <i class="fas fa-desktop icon-contextual"></i>
                        Sélectionnez l'équipement à attribuer
                    </div> #}
                    {{ form_errors(form.equipement) }}
                </div>
            </div>
            
            <div class="col-md-6 mb-3">
                <div class="form-group">
                    <i class="fas fa-user icon-contextual"></i>
                    {{ form_label(form.utilisateur, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.utilisateur, {'attr': {'class': 'form-select'}}) }}
                    {# <div class="form-text">
                        <i class="fas fa-user icon-contextual"></i>
                        Choisissez l'utilisateur bénéficiaire
                    </div> #}
                    {{ form_errors(form.utilisateur) }}
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer bg-light">
        <div class="d-flex justify-content-between">
            <a href="{{ path('app_attribution_index') }}" class="btn btn-secondary btn-add">
                <i class="fas fa-arrow-left me-2"></i>Annuler
            </a>
            <button type="submit" class="btn btn-success btn-add">
                <i class="fas fa-save me-2"></i>{{ button_label|default('Enregistrer') }}
            </button>
        </div>
    </div>
</div>
{{ form_end(form) }}
