{% extends 'base.html.twig' %}

{% block title %}Inscription - TrackMateriel{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow">
                <div class="card-body">
                    <div class="text-center mb-4">
                        <h2><i class="bi bi-person-plus text-success"></i></h2>
                        <h3>Inscription</h3>
                        <p class="text-muted">Créer un compte TrackMateriel</p>
                    </div>

                    {{ form_start(registrationForm, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}
                    
                    <div class="mb-3">
                        {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(registrationForm.email) }}
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(registrationForm.username, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(registrationForm.username) }}
                        {{ form_errors(registrationForm.username) }}
                    </div>

                    <div class="mb-3">
                        <label for="role" class="form-label">
                            {# <i class="bi bi-shield"></i> #}
                             Rôle
                        </label>
                        <select name="role" id="role" class="form-select" required>
                            <option value="">Choisir un rôle...</option>
                            <option value="ROLE_USER">Utilisateur standard</option>
                            <option value="ROLE_ADMIN">Administrateur</option>
                        </select>
                        {# <div class="form-text">
                            <small class="text-muted">
                                <strong>Utilisateur standard :</strong> Peut consulter ses attributions<br>
                                <strong>Administrateur :</strong> Accès complet à la gestion du système
                            </small>
                        </div> #}
                    </div>

                    <div class="mb-3">
                        {{ form_label(registrationForm.plainPassword.first, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(registrationForm.plainPassword.first) }}
                        {{ form_errors(registrationForm.plainPassword.first) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(registrationForm.plainPassword.second, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(registrationForm.plainPassword.second) }}
                        {{ form_errors(registrationForm.plainPassword.second) }}
                    </div>

                    <div class="mb-3 form-check">
                        {{ form_widget(registrationForm.agreeTerms) }}
                        {{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'form-check-label'}}) }}
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-person-plus"></i> S'inscrire
                        </button>
                    </div>

                    {{ form_end(registrationForm) }}

                    <hr>

                    <div class="text-center">
                        <small class="text-muted">
                            Déjà un compte ?
                            <a href="{{ path('app_login') }}" class="text-decoration-none">
                                Se connecter
                            </a>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
