{% extends 'base.html.twig' %}

{% block title %}Accueil - TrackMateriel{% endblock %}

{% block body %}
{% if app.user %}
<div class="container">
    <!-- En-tête de bienvenue -->
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-4 mb-3">
                <i class="bi bi-tools text-primary"></i>
                TrackMateriel
            </h1>
            <p class="lead text-muted">
                Système de gestion et de suivi du matériel informatique
            </p>
        </div>
    </div>

    <!-- Cartes des sections principales -->
    <div class="row g-4">
        <div class="col-lg-3 col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="h1 text-primary mb-3">
                        <i class="bi bi-house"></i>
                    </div>
                    <h5 class="card-title">Accueil</h5>
                    <p class="card-text text-muted">
                        Tableau de bord principal avec vue d'ensemble du système
                    </p>
                    <a href="{{ path('app_home') }}" class="btn btn-primary">
                        Accéder
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="h1 text-success mb-3">
                        <i class="bi bi-laptop"></i>
                    </div>
                    <h5 class="card-title">Équipement</h5>
                    <p class="card-text text-muted">
                        Gestion complète du matériel informatique et des ressources
                    </p>
                    <a href="{{ path('app_equipement_index') }}" class="btn btn-success">
                        Gérer
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="h1 text-warning mb-3">
                        <i class="bi bi-person-check"></i>
                    </div>
                    <h5 class="card-title">Attribution</h5>
                    <p class="card-text text-muted">
                        Attribution et suivi du matériel aux utilisateurs
                    </p>
                    <a href="{{ path('app_attribution_index') }}" class="btn btn-warning">
                        Attribuer
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="h1 text-info mb-3">
                        <i class="bi bi-wrench"></i>
                    </div>
                    <h5 class="card-title">Maintenance</h5>
                    <p class="card-text text-muted">
                        Planification et suivi des opérations de maintenance
                    </p>
                    <a href="{{ path('app_maintenance_index') }}" class="btn btn-info">
                        Planifier
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Section informations -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5 class="card-title">
                                <i class="bi bi-info-circle text-primary"></i>
                                À propos de TrackMateriel
                            </h5>
                            <p class="card-text">
                                TrackMateriel est une solution complète pour la gestion du matériel informatique.
                                Il permet de suivre les équipements, leurs attributions aux utilisateurs et 
                                la planification des maintenances.
                            </p>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="badge bg-primary fs-6 p-2">
                                Version 1.0
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section utilisateur connecté -->
    {% if is_granted('ROLE_ADMIN') %}
    <div class="row mt-4">
        <div class="col-12">
            <div class="alert alert-info">
                <i class="bi bi-shield-check"></i>
                <strong>Mode Administrateur activé</strong> - Vous avez accès à toutes les fonctionnalités de gestion.
            </div>
        </div>
    </div>
    {% endif %}
</div>

{% else %}
<!-- Message pour utilisateurs non connectés -->
<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body py-5">
                    <div class="h1 text-primary mb-4">
                        <i class="bi bi-tools"></i>
                    </div>
                    <h2 class="card-title">Bienvenue sur TrackMateriel</h2>
                    <p class="card-text lead text-muted mb-4">
                        Système de gestion et de suivi du matériel informatique
                    </p>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg me-md-2">
                            <i class="bi bi-box-arrow-in-right"></i>
                            Se connecter
                        </a>
                        <a href="#" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-info-circle"></i>
                            En savoir plus
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}