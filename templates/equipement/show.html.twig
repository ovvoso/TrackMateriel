{% extends 'base.html.twig' %}

{% block title %}Détails de l'Équipement{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- improved design -->
            <div class="card card-modern">
                <div class="card-header bg-primary text-white">
                    <h1 class="h3 mb-0">
                        <i class="fas fa-box icon-contextual"></i>Détails de l'Équipement
                    </h1>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="info-item">
                                <label class="text-muted small mb-1">
                                    <i class="fas fa-tag icon-contextual"></i>Nom de l'équipement
                                </label>
                                <div class="h5 text-dark">{{ equipement.nom }}</div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="info-item">
                                <label class="text-muted small mb-1">
                                    <i class="fas fa-layer-group icon-contextual"></i>Type
                                </label>
                                <div>
                                    <span class="badge bg-info badge-etat">{{ equipement.type }}</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="info-item">
                                <label class="text-muted small mb-1">
                                    <i class="fas fa-check-circle icon-contextual"></i>État
                                </label>
                                <div>
                                    <span class="badge {% if equipement.etat == 'Bon' %}bg-success{% elseif equipement.etat == 'Moyen' %}bg-warning text-dark{% else %}bg-danger{% endif %} badge-etat">
                                        {{ equipement.etat }}
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <a href="{{ path('app_equipement_index') }}" class="btn btn-outline-secondary btn-add">
                            <i class="fas fa-arrow-left me-2"></i>Retour à la liste
                        </a>
                        <div class="d-flex gap-2">
                            <a href="{{ path('app_equipement_edit', {'id': equipement.id}) }}" class="btn btn-warning btn-add">
                                <i class="fas fa-edit me-2"></i>Modifier
                            </a>
                            <button type="button" class="btn btn-danger btn-add" onclick="confirmDelete()">
                                <i class="fas fa-trash me-2"></i>Supprimer
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmation -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle text-warning me-2"></i>Confirmer la suppression
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Êtes-vous sûr de vouloir supprimer l'équipement "{{ equipement.nom }}" ?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                {{ include('equipement/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>

<script>
function confirmDelete() {
    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
    modal.show();
}
</script>

<style>
.info-item {
    padding: 15px;
    background-color: #f8f9fa;
    border-radius: var(--border-radius);
    border-left: 4px solid var(--primary-color);
    transition: all 0.3s ease;
}

.info-item:hover {
    background-color: #e9ecef;
    transform: translateX(2px);
}
</style>
{% endblock %}
