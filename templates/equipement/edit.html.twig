{% extends 'base.html.twig' %}

{% block title %}Modifier Équipement{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center mb-4">
                <i class="fas fa-edit fa-2x text-warning me-3"></i>
                <div>
                    <h1 class="h2 mb-0">Modifier l'équipement</h1>
                    <p class="text-muted mb-0">{{ equipement.nom }} - {{ equipement.type }}</p>
                </div>
            </div>
            {{ include('equipement/_form.html.twig', {'button_label': 'Mettre à jour'}) }} 
        </div>
    </div>
</div>
{% endblock %}
