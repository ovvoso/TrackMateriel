{% extends 'base.html.twig' %}

{% block title %}Gestion des Équipements{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <!-- improved design -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">
            <i class="fas fa-box icon-contextual"></i>Gestion des Équipements
        </h1>
        <a href="{{ path('app_equipement_new') }}" class="btn btn-success btn-lg btn-add">
            <i class="fas fa-plus me-2"></i>Nouvel Équipement
        </a>
    </div>

    {% if equipements|length > 0 %}
        <div class="row">
            {% for equipement in equipements %}
                <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                    <!-- improved design -->
                    <div class="card card-modern h-100">
                        <div class="card-header bg-light border-0">
                            <h5 class="card-title mb-0 text-truncate">
                                <i class="fas fa-desktop icon-contextual text-primary"></i>{{ equipement.nom }}
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <small class="text-muted d-block mb-1">
                                    <i class="fas fa-layer-group icon-contextual"></i>Type:
                                </small>
                                <span class="badge bg-info badge-etat">{{ equipement.type }}</span>
                            </div>
                            <div class="mb-4">
                                <small class="text-muted d-block mb-1">
                                    <i class="fas fa-check-circle icon-contextual"></i>État:
                                </small>
                                <span class="badge {% if equipement.etat == 'Bon' %}bg-success{% elseif equipement.etat == 'Moyen' %}bg-warning text-dark{% else %}bg-danger{% endif %} badge-etat">
                                    {{ equipement.etat }}
                                </span>
                            </div>
                            <!-- improved design - boutons d'action avec icônes circulaires -->
                            <div class="d-flex justify-content-center gap-2">
                                <a href="{{ path('app_equipement_show', {'id': equipement.id}) }}" 
                                   class="btn-action btn-view" title="Voir les détails">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_equipement_edit', {'id': equipement.id}) }}" 
                                   class="btn-action btn-edit" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn-action btn-delete" 
                                        title="Supprimer" onclick="deleteEquipement({{ equipement.id }})">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <!-- improved design -->
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="fas fa-inbox fa-4x text-muted"></i>
            </div>
            <h4 class="text-muted mb-3">Aucun équipement trouvé</h4>
            <p class="text-muted mb-4">Commencez par ajouter votre premier équipement</p>
            <a href="{{ path('app_equipement_new') }}" class="btn btn-primary btn-add">
                <i class="fas fa-plus me-2"></i>Ajouter un équipement
            </a>
        </div>
    {% endif %}
</div>

<!-- Modal de confirmation de suppression -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle text-warning me-2"></i>Confirmer la suppression
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Êtes-vous sûr de vouloir supprimer cet équipement ?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    <input type="hidden" name="_token" id="deleteToken">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-2"></i>Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
function deleteEquipement(id) {
    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
    const form = document.getElementById('deleteForm');
    form.action = '{{ path('app_equipement_delete', {'id': 'ID_PLACEHOLDER'}) }}'.replace('ID_PLACEHOLDER', id);
    document.getElementById('deleteToken').value = '{{ csrf_token('delete') }}' + id;
    modal.show();
}
</script>
{% endblock %}
