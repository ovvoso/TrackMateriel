{% extends 'layout/auth.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block auth %}
    <h1 class="auth-title">Connexion</h1>
    <p class="auth-lead">Accédez à l’espace de gestion du matériel de votre établissement.</p>

    <form method="post" class="auth-form" novalidate>
        {% if error %}
            <div class="alert alert-danger" role="alert">
                {{ ux_icon('lucide:circle-alert', {'aria-hidden': 'true'}) }}
                <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
            </div>
        {% endif %}

        <div class="field">
            <label class="field-label" for="email">Adresse e-mail</label>
            <input class="input" type="email" id="email" name="email" value="{{ last_username }}"
                   autocomplete="email" required {{ last_username ? '' : 'autofocus' }} placeholder="prenom.nom@etablissement.fr">
        </div>

        <div class="field">
            <div class="field-label-row">
                <label class="field-label" for="password">Mot de passe</label>
                <a class="field-link" href="{{ path('app_password_forgotten') }}">Mot de passe oublié ?</a>
            </div>
            <input class="input" type="password" id="password" name="password"
                   autocomplete="current-password" required {{ last_username ? 'autofocus' }}>
        </div>

        <label class="checkbox">
            <input type="checkbox" name="_remember_me">
            Rester connecté sur cet appareil
        </label>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" data-controller="csrf-protection">

        <button type="submit" class="btn btn-primary btn-block">Se connecter</button>

        <p class="auth-note">Pas encore de compte ? Les accès sont créés par l’administrateur de votre établissement.</p>
    </form>
{% endblock %}
