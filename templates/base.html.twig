<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{% endblock %}{{ block('title') is not empty ? ' · ' }}TrackMatériel</title>
        <meta name="description" content="Gestion du parc matériel des établissements d'enseignement : inventaire, prêts, réservations et maintenance.">
        <meta name="color-scheme" content="light dark">
        <meta name="csp-nonce" content="{{ csp_nonce() }}">
        <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
        {% for sheet in ['tokens', 'base', 'components', 'layout'] %}
            <link rel="stylesheet" href="{{ asset('styles/' ~ sheet ~ '.css') }}">
        {% endfor %}
        {% block importmap %}{{ importmap('app', {nonce: csp_nonce()}) }}{% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
