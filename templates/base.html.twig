<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}TrackMateriel{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css" rel="stylesheet">
        <!-- Font Awesome pour les icônes -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <!-- Remix Icon -->
        <link rel="stylesheet" href="{{ asset('vendor/remixicon/remixicon.css') }}">
        {% block stylesheets %}{% endblock %}
        
        <!-- Styles CSS globaux pour améliorer le design -->
        <style>
            /* Palette de couleurs cohérente */
            :root {
                --primary-color: #0d6efd;
                --secondary-color: #6c757d;
                --success-color: #198754;
                --warning-color: #ffc107;
                --danger-color: #dc3545;
                --info-color: #0dcaf0;
                --light-bg: #f8f9fa;
                --border-radius: 0.5rem;
                --shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
                --shadow-lg: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            }
            
            /* Boutons d'action avec icônes circulaires */
            .btn-action {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                text-decoration: none;
                transition: all 0.3s ease;
                border: none;
                margin: 0 2px;
            }
            
            .btn-action:hover {
                transform: scale(1.1);
                box-shadow: var(--shadow-lg);
            }
            
            .btn-action.btn-view {
                background-color: var(--primary-color);
                color: white;
            }
            
            .btn-action.btn-view:hover {
                background-color: #0b5ed7;
                color: white;
            }
            
            .btn-action.btn-edit {
                background-color: var(--warning-color);
                color: #212529;
            }
            
            .btn-action.btn-edit:hover {
                background-color: #ffca2c;
                color: #212529;
            }
            
            .btn-action.btn-delete {
                background-color: var(--danger-color);
                color: white;
            }
            
            .btn-action.btn-delete:hover {
                background-color: #bb2d3b;
                color: white;
            }
            
            /* Cards avec design moderne */
            .card-modern {
                border-radius: var(--border-radius);
                border: none;
                box-shadow: var(--shadow);
                transition: all 0.3s ease;
            }
            
            .card-modern:hover {
                box-shadow: var(--shadow-lg);
                transform: translateY(-2px);
            }
            
            /* Titres cohérents */
            .page-title {
                font-size: 2rem;
                font-weight: 600;
                color: var(--primary-color);
                margin-bottom: 1.5rem;
            }
            
            /* Boutons d'ajout améliorés */
            .btn-add {
                border-radius: var(--border-radius);
                font-weight: 500;
                padding: 0.75rem 1.5rem;
                transition: all 0.3s ease;
            }
            
            .btn-add:hover {
                transform: translateY(-1px);
                box-shadow: var(--shadow-lg);
            }
            
            /* Tableaux améliorés */
            .table-modern {
                border-radius: var(--border-radius);
                overflow: hidden;
            }
            
            .table-modern thead th {
                background-color: #343a40;
                color: white;
                border: none;
                font-weight: 500;
            }
            
            /* États des équipements */
            .badge-etat {
                font-size: 0.875rem;
                padding: 0.5rem 0.75rem;
                border-radius: 1rem;
            }
            
            /* Espacement cohérent */
            .section-spacing {
                margin-bottom: 2rem;
            }
            
            /* Icônes contextuelles */
            .icon-contextual {
                margin-right: 0.5rem;
                opacity: 0.8;
            }
            
            /* Styles pour la section utilisateur */
            .user-section {
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }
            
            .user-info {
                color: rgba(255, 255, 255, 0.9);
                font-size: 0.9rem;
            }
            
            .logout-btn {
                background: rgba(255, 255, 255, 0.1);
                border: 1px solid rgba(255, 255, 255, 0.2);
                color: white;
                padding: 0.5rem 1rem;
                border-radius: 0.375rem;
                text-decoration: none;
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }
            
            .logout-btn:hover {
                background: rgba(255, 255, 255, 0.2);
                color: white;
                text-decoration: none;
                transform: translateY(-1px);
            }
            
            @media (max-width: 991px) {
                .user-section {
                    flex-direction: column;
                    align-items: flex-start;
                    margin-top: 1rem;
                    padding-top: 1rem;
                    border-top: 1px solid rgba(255, 255, 255, 0.1);
                }
            }
        </style>
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_home') }}">
                    <i class="bi bi-tools"></i> TrackMateriel
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <div class="navbar-nav me-auto">
                        <a class="nav-link" href="{{ path('app_home') }}">
                            <i class="bi bi-house"></i> Accueil
                        </a>
                        <a class="nav-link" href="{{ path('app_equipement_index') }}">
                            <i class="bi bi-laptop"></i> Équipement
                        </a>
                        <a class="nav-link" href="{{ path('app_attribution_index') }}">
                            <i class="bi bi-person-check"></i> Attribution
                        </a>
                        <a class="nav-link" href="{{ path('app_maintenance_index') }}">
                            <i class="bi bi-wrench"></i> Maintenance
                        </a>
                    </div>
                    
                    <!-- Section utilisateur et déconnexion -->
                    {% if app.user %}
                        <div class="user-section">
                            <div class="user-info">
                                <i class="ri-user-fill"></i>
                                <span>{{ app.user.username }}</span>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <span class="badge bg-warning text-dark ms-1">Admin</span>
                                {% elseif is_granted('ROLE_USER') %}
                                    <span class="badge bg-secondary text-white ms-1">User</span>
                                {% endif %}
                            </div>
                            <a href="{{ path('app_logout') }}" class="logout-btn" 
                               onclick="return confirm('Êtes-vous sûr de vouloir vous déconnecter ?')">
                                <i class="ri-logout-box-line"></i>
                                <span>Déconnexion</span>
                            </a>
                        </div>
                    {% else %}
                        <div class="navbar-nav">
                            <a class="nav-link" href="{{ path('app_login') }}">
                                <i class="ri-login-box-line"></i> Connexion
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </nav>

        <main class="container-fluid py-4">
            {% for category, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ category == 'error' ? 'danger' : category }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}
            
            {% block body %}{% endblock %}
        </main>
        
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>