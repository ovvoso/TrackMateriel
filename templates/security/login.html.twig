{% extends 'base.html.twig' %}

{% block title %}Connexion - TrackMateriel{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body">
                    <div class="text-center mb-4">
                        <h2><i class="bi bi-shield-lock text-primary"></i></h2>
                        <h3>Connexion</h3>
                        <p class="text-muted">TrackMateriel</p>
                    </div>

                    {% if error %}
                        <div class="alert alert-danger">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    {% if app.user %}
                        <div class="alert alert-info text-center">
                            Vous êtes déjà connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>.
                            <br><a href="{{ path('app_logout') }}" class="btn btn-sm btn-outline-primary mt-2">Déconnexion</a>
                        </div>
                    {% else %}
                        <form method="post">
                            <div class="mb-3">
                                <label for="username" class="form-label">
                                    <i class="bi bi-envelope"></i> Email
                                </label>
                                <input type="email" 
                                       value="{{ last_username }}" 
                                       name="_username" 
                                       id="username" 
                                       class="form-control" 
                                       autocomplete="email" 
                                       required 
                                       autofocus
                                       placeholder="votre.email@exemple.com">
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label">
                                    <i class="bi bi-lock"></i> Mot de passe
                                </label>
                                <input type="password" 
                                       name="_password" 
                                       id="password" 
                                       class="form-control" 
                                       autocomplete="current-password" 
                                       required
                                       placeholder="Votre mot de passe">
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="d-grid mb-3">
                                <button class="btn btn-primary" type="submit">
                                    <i class="bi bi-box-arrow-in-right"></i> Se connecter
                                </button>
                            </div>

                            <div class="text-center">
                                <small>
                                    <a href="{{ path('app_forgot_password') }}" class="text-decoration-none text-muted">
                                        Mot de passe oublié ?
                                    </a>
                                </small>
                            </div>

                            <hr>

                            <div class="text-center">
                                <small class="text-muted">
                                    Pas encore de compte ?
                                    <a href="{{ path('app_register') }}" class="text-decoration-none">
                                        S'inscrire
                                    </a>
                                </small>
                            </div>
                        </form>
                    {% endif %}
                </div>
            </div>

            <!-- Comptes de démonstration -->
            {# <div class="card mt-3">
                <div class="card-body">
                    <h6 class="card-title text-center">
                        <i class="bi bi-info-circle"></i> Comptes de démonstration
                    </h6>
                    <div class="row">
                        <div class="col-6">
                            <small>
                                <strong>Admin:</strong><br>
                                admin-moas@gmail.com<br>
                                PASSER
                            </small>
                        </div>
                        <div class="col-6">
