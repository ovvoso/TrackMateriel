{% extends 'email/base.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;">Bonjour {{ user.firstName }},</h1>
    <p style="margin:0;">Une demande de réinitialisation du mot de passe a été faite pour votre compte. Pour en choisir un nouveau :</p>
    {{ include('email/_button.html.twig', {label: 'Choisir un nouveau mot de passe'}) }}
    <p style="margin:24px 0 0;font-size:14px;color:#5a5752;">
        Ce lien reste valable une heure et ne sert qu’une fois. Si vous n’êtes pas à l’origine de cette demande,
        ignorez ce message : votre mot de passe actuel reste valable.
    </p>
{% endblock %}
