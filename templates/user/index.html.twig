{% extends 'base.html.twig' %}

{% block title %}Dashboard Utilisateur - TrackMateriel{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1><i class="bi bi-person-circle text-primary"></i> Dashboard Utilisateur</h1>
                <div>
                    <span class="badge bg-primary">USER</span>
                    <span class="text-muted">{{ app.user.email }}</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Cartes d'accès -->
    <div class="row g-4 mb-5">
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="h2 text-primary mb-3">
                        <i class="bi bi-laptop"></i>
                    </div>
                    <h5 class="card-title">Équipements</h5>
                    <p class="card-text text-muted">Consulter la liste du matériel</p>
                    <a href="{{ path('app_equipement_index') }}" class="btn btn-primary">Consulter</a>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="h2 text-success mb-3">
                        <i class="bi bi-person-check"></i>
                    </div>
                    <h5 class="card-title">Mes Attributions</h5>
                    <p class="card-text text-muted">Voir le matériel qui m'est attribué</p>
                    <a href="{{ path('user_attributions') }}" class="btn btn-success">Voir</a>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="h2 text-warning mb-3">
                        <i class="bi bi-wrench"></i>
                    </div>
                    <h5 class="card-title">Maintenances</h5>
                    <p class="card-text text-muted">Signaler un problème</p>
                    <a href="{{ path('app_maintenance_new') }}" class="btn btn-warning">Signaler</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Informations -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-info-circle"></i> Informations</h5>
                </div>
                <div class="card-body">
                    <p>Bienvenue sur votre espace utilisateur TrackMateriel. Vous pouvez :</p>
                    <ul>
                        <li>Consulter la liste des équipements disponibles</li>
                        <li>Voir le matériel qui vous est attribué</li>
                        <li>Signaler des problèmes de maintenance</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
