{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe - TrackMateriel{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body">
                    <div class="text-center mb-4">
                        <h2><i class="bi bi-shield-lock-fill text-success"></i></h2>
                        <h3>Nouveau mot de passe</h3>
                        <p class="text-muted">Définir un nouveau mot de passe pour <strong>{{ user.email }}</strong></p>
                    </div>

                    <form method="post">
                        <div class="mb-3">
                            <label for="password" class="form-label">
                                <i class="bi bi-lock"></i> Nouveau mot de passe
                            </label>
                            <input type="password" 
                                   name="password" 
                                   id="password" 
                                   class="form-control" 
                                   required 
                                   placeholder="Nouveau mot de passe"
                                   minlength="6">
                            <div class="form-text">
                                <small class="text-muted">Minimum 6 caractères</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="confirm_password" class="form-label">
                                <i class="bi bi-lock-fill"></i> Confirmer le mot de passe
                            </label>
                            <input type="password" 
                                   name="confirm_password" 
                                   id="confirm_password" 
                                   class="form-control" 
                                   required 
                                   placeholder="Confirmer le mot de passe"
                                   minlength="6">
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle"></i> Réinitialiser le mot de passe
                            </button>
                        </div>
                    </form>

                    <div class="text-center">
                        <a href="{{ path('app_login') }}" class="text-decoration-none">
                            <i class="bi bi-arrow-left"></i> Retour à la connexion
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Validation côté client pour la confirmation du mot de passe
document.addEventListener('DOMContentLoaded', function() {
    const password = document.getElementById('password');
    const confirmPassword = document.getElementById('confirm_password');
    
    function validatePassword() {
        if (password.value !== confirmPassword.value) {
            confirmPassword.setCustomValidity('Les mots de passe ne correspondent pas');
        } else {
            confirmPassword.setCustomValidity('');
        }
    }
    
    password.addEventListener('change', validatePassword);
    confirmPassword.addEventListener('keyup', validatePassword);
});
</script>
{% endblock %}
