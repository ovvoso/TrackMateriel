{% extends 'base.html.twig' %}

{% block title %}Vérifiez votre email - TrackMateriel{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow">
                <div class="card-body text-center">
                    <div class="mb-4">
                        <h2><i class="bi bi-envelope-check text-success"></i></h2>
                        <h3>Vérifiez votre email</h3>
                    </div>

                    <div class="alert alert-success">
                        <p class="mb-3">
                            <i class="bi bi-info-circle"></i>
                            Un email contenant un lien de réinitialisation a été envoyé à votre adresse si elle existe dans notre système.
                        </p>
                        <p class="mb-0">
                            <small>Le lien expire dans <strong>1 heure</strong>.</small>
                        </p>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-muted">Vous n'avez pas reçu l'email ?</h6>
                        <ul class="list-unstyled text-muted small">
                            <li><i class="bi bi-check2"></i> Vérifiez votre dossier spam</li>
                            <li><i class="bi bi-check2"></i> Assurez-vous que l'adresse email est correcte</li>
                            <li><i class="bi bi-check2"></i> Attendez quelques minutes</li>
                        </ul>
                    </div>

                    <div class="d-grid gap-2">
                        <a href="{{ path('app_forgot_password') }}" class="btn btn-outline-warning">
                            <i class="bi bi-arrow-repeat"></i> Renvoyer l'email
                        </a>
                        <a href="{{ path('app_login') }}" class="btn btn-primary">
                            <i class="bi bi-arrow-left"></i> Retour à la connexion
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
