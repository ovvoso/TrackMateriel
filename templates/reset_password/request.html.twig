{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - TrackMateriel{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body">
                    <div class="text-center mb-4">
                        <h2><i class="bi bi-key text-warning"></i></h2>
                        <h3>Mot de passe oublié</h3>
                        <p class="text-muted">Réinitialiser votre mot de passe</p>
                    </div>

                    <div class="alert alert-info">
                        <small>
                            <i class="bi bi-info-circle"></i>
                            Pour la démonstration, utilisez ce lien direct :
                            <br><a href="{{ path('app_reset_password', {'token': 'demo-token'}) }}" class="alert-link">Réinitialiser le mot de passe</a>
                        </small>
                    </div>

                    <div class="text-center mt-3">
                        <a href="{{ path('app_login') }}" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-left"></i> Retour à la connexion
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
