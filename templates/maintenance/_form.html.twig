{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}
<!-- improved design -->
<div class="card card-modern">
    <div class="card-header bg-warning text-dark">
        <h5 class="mb-0">
            <i class="fas fa-wrench icon-contextual"></i>Informations de la maintenance
        </h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="form-group">
                    <i class="fas fa-calendar-alt icon-contextual"></i>
                    {{ form_label(form.date, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.date) }}
                </div>
            </div>
            
            <div class="col-md-6 mb-3">
                <div class="form-group">
                    <i class="fas fa-desktop icon-contextual"></i>
                    {{ form_label(form.equipement, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.equipement, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.equipement) }}
                </div>
            </div>
            
            <div class="col-12 mb-3">
                <div class="form-group">
                    <i class="fas fa-sticky-note icon-contextual"></i>
                    {{ form_label(form.observation, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.observation, {'attr': {'class': 'form-control', 'rows': '4'}}) }}
                    {{ form_errors(form.observation) }}
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer bg-light">
        <div class="d-flex justify-content-between">
            <a href="{{ path('app_maintenance_index') }}" class="btn btn-secondary btn-add">
                <i class="fas fa-arrow-left me-2"></i>Annuler
            </a>
            <button type="submit" class="btn btn-warning btn-add">
                <i class="fas fa-save me-2"></i>{{ button_label|default('Enregistrer') }}
            </button>
        </div>
    </div>
</div>
{{ form_end(form) }}
