{% extends 'base.html.twig' %}

{% block title %}Détails de la Maintenance{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- improved design -->
            <div class="card card-modern">
                <div class="card-header bg-primary text-white">
                    <h1 class="h3 mb-0">
                        <i class="fas fa-wrench icon-contextual"></i>Détails de la Maintenance
                    </h1>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <div class="info-card">
                                <div class="info-header">
                                    <i class="fas fa-calendar-alt text-primary"></i>
                                    <span class="text-muted small">Date de maintenance</span>
                                </div>
                                <div class="info-content">
                                    {{ maintenance.date ? maintenance.date|date('d/m/Y H:i:s') : 'Non définie' }}
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <div class="info-card">
                                <div class="info-header">
                                    <i class="fas fa-desktop text-info"></i>
                                    <span class="text-muted small">Équipement</span>
                                </div>
                                <div class="info-content">
                                    {{ maintenance.equipement ? maintenance.equipement.nom : 'Non assigné' }}
                                </div>
                                {% if maintenance.equipement %}
                                    <div class="text-muted small mt-1">
                                        <i class="fas fa-layer-group icon-contextual"></i>{{ maintenance.equipement.type }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="info-card">
                            <div class="info-header">
                                <i class="fas fa-sticky-note text-warning"></i>
                                <span class="text-muted small">Observation</span>
                            </div>
                            <div class="info-content">
                                <div class="p-3 bg-light rounded border-start border-warning border-4">
                                    {{ maintenance.observation ? maintenance.observation : 'Aucune observation' }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <a href="{{ path('app_maintenance_index') }}" class="btn btn-outline-secondary btn-add">
                            <i class="fas fa-arrow-left me-2"></i>Retour à la liste
                        </a>
                        <div class="d-flex gap-2">
                            <a href="{{ path('app_maintenance_edit', {'id': maintenance.id}) }}" class="btn btn-warning btn-add">
                                <i class="fas fa-edit me-2"></i>Modifier
                            </a>
                            <button type="button" class="btn btn-danger btn-add" onclick="confirmDelete()">
                                <i class="fas fa-trash me-2"></i>Supprimer
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmation -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle text-warning me-2"></i>Confirmer la suppression
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Êtes-vous sûr de vouloir supprimer cette maintenance ?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                {{ include('maintenance/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>

<script>
function confirmDelete() {
    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
    modal.show();
}
</script>

<style>
.info-card {
    padding: 20px;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    border-radius: var(--border-radius);
    border-left: 4px solid var(--primary-color);
    height: 100%;
    transition: all 0.3s ease;
}

.info-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
}

.info-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
}

.info-content {
    font-size: 1.1rem;
    font-weight: 500;
    color: #495057;
}
</style>
{% endblock %}
