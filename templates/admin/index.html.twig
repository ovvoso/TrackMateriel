{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin - TrackMateriel{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1><i class="bi bi-speedometer2 text-primary"></i> Dashboard Administrateur</h1>
                <div>
                    <span class="badge bg-success">ADMIN</span>
                    <span class="text-muted">{{ app.user.email }}</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Cartes de gestion -->
    <div class="row g-4 mb-5">
        <div class="col-lg-3 col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="h2 text-primary mb-3">
                        <i class="bi bi-laptop"></i>
                    </div>
                    <h5 class="card-title">Équipements</h5>
                    <p class="card-text text-muted">Gérer tout le matériel informatique</p>
                    <a href="{{ path('app_equipement_index') }}" class="btn btn-primary">Gérer</a>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="h2 text-success mb-3">
                        <i class="bi bi-person-check"></i>
                    </div>
                    <h5 class="card-title">Attributions</h5>
                    <p class="card-text text-muted">Attribuer le matériel aux utilisateurs</p>
                    <a href="{{ path('admin_attribution_index') }}" class="btn btn-success">Gérer</a>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="h2 text-warning mb-3">
                        <i class="bi bi-wrench"></i>
                    </div>
                    <h5 class="card-title">Maintenances</h5>
                    <p class="card-text text-muted">Planifier les opérations de maintenance</p>
                    <a href="{{ path('app_maintenance_index') }}" class="btn btn-warning">Gérer</a>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="h2 text-info mb-3">
                        <i class="bi bi-people"></i>
                    </div>
                    <h5 class="card-title">Utilisateurs</h5>
                    <p class="card-text text-muted">Gérer les comptes utilisateurs</p>
                    <a href="#" class="btn btn-info">Gérer</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions rapides -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-lightning"></i> Actions rapides</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <a href="{{ path('app_equipement_new') }}" class="btn btn-outline-primary w-100 mb-2">
                                <i class="bi bi-plus-circle"></i> Nouvel équipement
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="{{ path('admin_attribution_new') }}" class="btn btn-outline-success w-100 mb-2">
                                <i class="bi bi-plus-circle"></i> Nouvelle attribution
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="{{ path('app_maintenance_new') }}" class="btn btn-outline-warning w-100 mb-2">
                                <i class="bi bi-plus-circle"></i> Nouvelle maintenance
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="{{ path('app_register') }}" class="btn btn-outline-info w-100 mb-2">
                                <i class="bi bi-person-plus"></i> Nouvel utilisateur
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}